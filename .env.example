# Copy to .env and edit. Never commit .env or actual passwords.
# Quote passwords containing #, $, spaces, etc. Values are NOT expanded by Python.
# Leave DATABASE empty to choose a database name in the web form.

MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=root
MARIADB_PASSWORD=''
MARIADB_DATABASE=
MARIADB_SSL_MODE=disable

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=''
POSTGRES_DATABASE=
POSTGRES_SSL_MODE=disable

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=''
MYSQL_DATABASE=
MYSQL_SSL_MODE=disable

# SQL result snapshot lifetime (seconds); exports never rerun SQL.
SQL_RESULT_TTL_SECONDS=3600
